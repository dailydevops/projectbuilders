{
  "stryker-config": {
    "solution": "ProjectBuilders.slnx",
    "mutation-level": "Advanced",
    "reporters": [
      "html",
      "json",
      "dashboard",
      "progress"
    ],
    "project-info": {
      "name": "github.com/dailydevops/projectbuilders"
    },
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "coverage-analysis": "perTest",
    "mutate": [
      "**/*.cs",
      "!**/*.Designer.cs",
      "!**/*.g.cs",
      "!**/*.g.i.cs"
    ],
    "test-runner": "mtp"
  }
}
