<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>

    <!-- Verify v33+ build-time license gate (SC021). ProjectBuilders is a non-revenue open source project, so the OpenSource exemption applies.
         See https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
         Renew yearly: the end month may be at most 12 months ahead of the build date; builds fail after 2027-09. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_snapshots/**/*.*" />
    <None Include="_snapshots/**/*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" VersionOverride="18.12.0" />
    <PackageReference Include="NetEvolve.Extensions.XUnit.V3" />
    <PackageReference Include="Verify.ParametersHashing" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="NetEvolve.Extensions.XUnit.V3.IntegrationTestAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetEvolve.ProjectBuilders.XUnit\NetEvolve.ProjectBuilders.XUnit.csproj" />
    <ProjectReference Include="..\..\src\NetEvolve.ProjectBuilders\NetEvolve.ProjectBuilders.csproj" />
  </ItemGroup>
</Project>
